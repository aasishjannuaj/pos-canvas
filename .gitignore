# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example carries NAMES and placeholders only — never a real credential.
# It is the one env file that must be committed, so every other .env* stays
# ignored and this single negation re-includes it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Feature 16.2 — Android shell.
# android-shell/www is regenerated from POS_CANVAS_ANDROID_SERVER_URL on every
# `npm run android:sync`, so it is build output, not source. The generator
# (android-shell/*.mjs) and capacitor.config.ts ARE tracked.
/android-shell/www/
# The native android/ project itself is tracked, but it carries its own
# .gitignore (generated by Capacitor) covering build/, .gradle/,
# local.properties, copied web assets, and generated capacitor config.
# local.properties is re-listed here because it contains a machine-specific
# absolute SDK path.
android/local.properties
