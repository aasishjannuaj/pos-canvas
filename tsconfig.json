{
  "compilerOptions": {
    // TYPE-CHECKING ONLY. With "noEmit": true and no `tsc` emit step in any
    // npm script, this target never produces shipped code: Next transpiles
    // through SWC/Turbopack against browserslist, so raising it changes no
    // runtime or browser-support behavior. ES2020 is required because BigInt
    // literals cannot be downleveled, and the Migration C rounding vectors
    // (supabase/migrations/20260803220000_*.test.ts) model PostgreSQL numeric
    // arithmetic with exact bigint math.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
