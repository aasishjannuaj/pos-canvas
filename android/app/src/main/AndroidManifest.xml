<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Feature 20 — allowBackup is FALSE.

      A paired till keeps its device session in WebView localStorage, inside the
      app's private data directory. With backup enabled, Android may copy that
      directory to the owner's Google account and restore it onto DIFFERENT
      hardware — which would place a working till credential on a device the
      owner never paired. Disabling backup makes a factory-reset device
      re-pair, which is the correct behaviour for point-of-sale hardware.

      An in-place APK upgrade (same applicationId, same signing key) is
      unaffected: it preserves the data directory without involving backup at
      all, so a paired device stays paired across updates.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Feature 24.5F — REQUIRED FOR RECONNECT, not for network access.

      Chromium's NetworkChangeNotifier observes connectivity through Android's
      ConnectivityManager, which needs this permission. Without it the WebView
      never learns that Wi-Fi or mobile data came back: navigator.onLine stays
      stale and the `online` event never fires.

      Real hardware proved the cost. A till with three queued offline sales had
      its connection restored while the app stayed open, and nothing drained for
      thirty seconds — the reconnect listener was registered and correct, but no
      event was ever delivered. Only restarting the app (which runs the startup
      sync) recovered it. The identical JavaScript on Windows drained fine,
      because desktop Chromium gets the notification without help.

      READ-ONLY AND NORMAL: this grants no ability to open connections — that is
      INTERNET, above — and Android classifies it as a normal permission, so it
      raises no runtime prompt. It is the smallest fix available and needs no
      Capacitor plugin.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
