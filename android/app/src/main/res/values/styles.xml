<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!-- 24.2 POLISH PASS — the brand ground, so the handover from the splash
             is seamless. This window exists from the moment the splash exits
             until the hosted runtime paints its first frame; at its default it
             was a flash of theme white between two cream screens. It is
             windowBackground (the window), not background (views), so the
             WebView still paints over it normally once it has content. -->
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>


    <!-- Feature 24.2 - the cold-start window: the very first thing Android
         draws for this app, before any of our code runs.

         WHY THESE TWO ATTRIBUTES EXIST: the parent Theme.SplashScreen leaves
         both unset, and the resulting defaults are not ours.

           - Background. On API 31+ androidx maps
             android:windowSplashScreenBackground to
             ?windowSplashScreenBackground (see the library's values-v31).
             Unset, that falls through to the platform's ?android:colorBackground
             - a Material You value, measured on an API 36 emulator as #EEEDF6
             in light mode and #181920 in dark. The cold-start screen therefore
             changed colour with the device theme and was never the brand ground.

           - Icon. On API 24-30 the compat layer-list draws
             ?windowSplashScreenAnimatedIcon, which the base Theme.SplashScreen
             defines as @android:drawable/sym_def_app_icon - the stock Android
             robot, not our mark. API 31+ happens to fall back to the launcher
             icon instead, so the two paths disagreed. Naming the mipmap pins
             both to the same approved artwork.

         The background is deliberately the SAME colour as the adaptive icon's
         own background, so the mark's anti-aliased edge meets the screen with
         no halo - the same reasoning recorded in values/ic_launcher_background.xml. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <!-- 24.2 POLISH PASS — a DEDICATED splash mark, not the launcher icon.
             @mipmap/ic_launcher is an adaptive icon: the platform scales its
             108dp canvas up to the splash's 288dp canvas (2.67x), and that
             canvas had itself been produced by downscaling the 376px master
             into a 66dp safe zone. The result on a real phone was a 2.67x
             upscale of an already-degraded image — roughly 34% of the pixels
             it was being asked to draw — which is the blur the owner reported.
             This drawable is cut from the same approved master in ONE resample,
             at the 288dp/192dp geometry the platform actually renders. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/pos_canvas_splash_icon</item>

        <!-- Required by androidx SplashScreen.installSplashScreen(), which
             MainActivity now calls so the brand stays visible long enough to
             register. Without it androidx has no theme to hand off to and logs
             a warning; Capacitor's own setTheme() then runs and reaches the
             same place, but relying on that would be relying on an accident. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

        <!-- Retained from the Capacitor template. The parent theme sets its own
             android:windowBackground, so this never paints the cold-start
             window; it is left in place because removing it is a boot-path
             change, which 24.2 is not. -->
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>