<?xml version="1.0" encoding="utf-8"?>
<!--
  24.2 polish pass — the Android 12+ system splash icon.

  A SEPARATE adaptive icon from @mipmap/ic_launcher, deliberately. The launcher
  icon must stay exactly as approved in 24.2 and is untouched; this one exists
  only so the splash can carry a far higher-resolution foreground than a 48dp
  launcher icon ever needs.

  WHY ADAPTIVE AND NOT A PLAIN PNG: verified on a real API 36 device, a plain
  bitmap in windowSplashScreenAnimatedIcon renders as nothing at all — cream
  background, no mark, and no error in logcat. The adaptive-icon path is what
  the platform actually draws.

  The background matches windowSplashScreenBackground exactly, so the masked
  edge meets the window with no seam and no halo.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/pos_canvas_splash_foreground"/>
</adaptive-icon>
