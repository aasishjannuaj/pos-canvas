<?xml version="1.0" encoding="utf-8"?>
<!--
  Feature 20 — DEBUG-ONLY network security config.

  This file exists at src/debug/, so Android's resource merger uses it INSTEAD
  of src/main/res/xml/network_security_config.xml when building the debug build
  type. It is never packaged into a release APK, which is exactly the point: the
  cleartext exceptions below cannot reach a customer's till, because the file
  itself is not in that artifact.

  base-config still denies cleartext globally. The two exceptions are the
  narrowest possible:
    - 10.0.2.2 is the Android emulator's fixed alias for the host machine's
      loopback interface. It is unroutable from any real network, so permitting
      cleartext to it carries no exposure off the development machine.
    - localhost covers a physical device port-forwarded with `adb reverse`.

  PHYSICAL DEVICE ON THE LAN: a phone reaches the dev machine by its LAN IP
  (e.g. 192.168.x.x), which is intentionally NOT listed. Add it here temporarily
  if needed, understanding that it permits cleartext to a routable address — and
  note that it still cannot affect a release build.

  `npm run android:sync` reads THIS file to check that a configured http host is
  actually permitted, and fails loudly with guidance if it is not (see
  android-shell/generateWww.mjs).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
