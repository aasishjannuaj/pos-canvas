# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
#
# Feature 20 — these were the Capacitor/Android template's COMMENTED-OUT
# defaults, which meant a keystore dropped anywhere under android/ was fully
# committable. They are now active, and this was the first change of the
# feature: no keystore may exist on this machine until after these lines are in
# place and verified with `git check-ignore`.
#
# WHY THIS MATTERS MORE THAN AN ORDINARY IGNORE RULE: an Android app's identity
# is its applicationId PLUS its signing certificate. A leaked release key lets
# anyone publish an "update" that Android will install over a real customer's
# till. There is no revocation, no rotation after distribution, and no recovery.
# Git history is effectively permanent, so a single committed .jks would mean
# abandoning the signing identity entirely.
#
# The real keystore lives OUTSIDE this repository (see DEPLOYMENT.md). These
# patterns exist as a second line of defence for the case where someone
# generates one into the project directory by habit.
*.jks
*.keystore
*.p12
*.pepk

# Local signing configuration. Holds the keystore path and three passwords, and
# is read conditionally by app/build.gradle. Never committed; an example with
# placeholders only is documented in DEPLOYMENT.md.
keystore.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
capacitor-cordova-android-plugins

# Copied web assets
app/src/main/assets/public

# Generated Config files
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml
