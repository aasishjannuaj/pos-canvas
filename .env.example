# POS Canvas — environment variable template.
#
# Copy to .env.local and fill in real values from your Supabase project:
#   cp .env.example .env.local
#
# NEVER put a real credential in THIS file. It is committed to the repository.
# Real values belong only in .env.local (gitignored) and in your hosting
# provider's environment settings (e.g. the Vercel dashboard).

# ---------------------------------------------------------------------------
# EXPOSED TO THE BROWSER
#
# Any NEXT_PUBLIC_ variable is inlined into the client JavaScript bundle at
# BUILD time and is readable by anyone who loads the site. Only put values here
# that are safe to publish. Both values below are designed to be public: the
# anon key is constrained by Row Level Security on every table.
#
# Because they are inlined at build time, changing either one in a hosting
# dashboard has NO effect until you redeploy.
# ---------------------------------------------------------------------------

# Supabase project URL. Dashboard: Project Settings -> API -> Project URL.
# Format: https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/publishable key (a JWT beginning "eyJ").
# Dashboard: Project Settings -> API -> Project API keys -> anon / public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRET
#
# The service-role key BYPASSES Row Level Security entirely. It must never be
# given a NEXT_PUBLIC_ prefix, never be referenced from a Client Component,
# and never be committed. Treat it like a database password.
#
# Used only by "server-only"-guarded code (lib/supabase/admin.ts) and by the
# standalone build worker (worker/supabase.ts). On Vercel, add it WITHOUT the
# NEXT_PUBLIC_ prefix so it stays server-side.
# ---------------------------------------------------------------------------

# Dashboard: Project Settings -> API -> Project API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRET — STARTS THE BUILD WORKER
#
# A fine-grained GitHub personal access token. POS Canvas uses it to dispatch
# .github/workflows/build-worker.yml the moment a build is queued; that workflow
# has no schedule, so without this token a build queues but never starts on its
# own. Read only by lib/githubBuildWorker.server.ts, which is "server-only".
#
# Scope it to the minimum: repository access limited to aasishjannuaj/pos-canvas,
# permission "Actions: Read and write", everything else No access. Contents write
# is NOT required — the token starts a run, it never pushes.
#
# NEVER give it a NEXT_PUBLIC_ prefix; that would publish it to every visitor.
# On Vercel this is a Production environment variable and only takes effect on a
# new deployment. Not needed for local development unless you want the local
# Build button to dispatch real GitHub runs; `npm run worker:once` processes a
# queued build locally without it. See DEPLOYMENT.md §3a.
# ---------------------------------------------------------------------------

# GitHub: Settings -> Developer settings -> Personal access tokens ->
# Fine-grained tokens. Format: "github_pat_...".
GITHUB_BUILD_WORKER_TOKEN=

# ---------------------------------------------------------------------------
# ANDROID SHELL — BUILD-TIME ONLY
#
# Read by capacitor.config.ts and android-shell/generateWww.mjs during
# `npm run android:sync`, and BAKED INTO THE ANDROID APP (it is written to
# android/app/src/main/assets/capacitor.config.json, which ships inside the
# APK in cleartext). It is a plain origin, never a secret — but changing it
# requires re-running the sync AND rebuilding the APK. There is no runtime
# switching.
#
# Not needed for `npm run dev`, `npm run build`, or any web deployment.
#
# Examples:
#   http://10.0.2.2:3000     Android emulator's alias for this machine
#   http://localhost:3000    physical device via `adb reverse`
#   https://your-app.vercel.app   hosted deployment
# ---------------------------------------------------------------------------

POS_CANVAS_ANDROID_SERVER_URL=
